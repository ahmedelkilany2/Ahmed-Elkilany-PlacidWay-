# --- LLM (any OpenAI-compatible endpoint; defaults to Groq's free tier) ---
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Crawler ---
CRAWLER_CONTACT=you@example.com        # shown in the User-Agent so PlacidWay can reach you
CRAWL_DELAY_SECONDS=1.0

# --- Retrieval ---
EMBEDDINGS=on                          # "off" = BM25 only (smaller image, still works)

# --- Ops ---
ADMIN_TOKEN=change-me                  # protects /api/admin/* (refresh, gaps, leads)
REFRESH_INTERVAL_HOURS=24              # 0 disables the background auto-refresh
LEAD_WEBHOOK_URL=                      # optional: POST each captured lead here (Zapier/n8n/Slack)
